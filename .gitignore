*.log
logs/
npm-debug.log*

# Local build / coverage output
coverage/
.nyc_output/
*.tsbuildinfo

# IDE
.idea/
.vscode/
.history/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor
*~
*.swp
*.swo
