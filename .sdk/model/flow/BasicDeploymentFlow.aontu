# BasicDeploymentFlow

main: kit: flow: BasicDeploymentFlow:
{
  entity: "deployment",
  kind: "basic",
  name: "BasicDeploymentFlow",
  step: [
    {
      i: {
        ref: "deployment_ref01"
      }

      m: {
        environment_uuid: "environment_uuid01",
        project_id: "project01",
        repo_slug: "repo_slug01",
        workspace: "workspace01",
        workspace_id: "workspace01"
      }

      o: "create"
    }

    {
      i: {
        ref: "deployment_ref01",
        srcdatavar: "deployment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "deployment01",
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deployment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "deployment_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "deployment01",
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicDeploymentFlow"
}