# BasicWatcherFlow

main: kit: flow: BasicWatcherFlow:
{
  entity: "watcher",
  kind: "basic",
  name: "BasicWatcherFlow",
  step: [
    {
      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "watcher_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWatcherFlow"
}