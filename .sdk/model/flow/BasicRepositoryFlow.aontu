# BasicRepositoryFlow

main: kit: flow: BasicRepositoryFlow:
{
  entity: "repository",
  kind: "basic",
  name: "BasicRepositoryFlow",
  step: [
    {
      i: {
        ref: "repository_ref01"
      }

      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "create"
    }

    {
      d: {
        workspace: "workspace01"
      }

      i: {
        ref: "repository_ref01",
        srcdatavar: "repository_ref01_data",
        suffix: "_up0",
        textfield: "created_on"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repository_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "repository_ref01",
        srcdatavar: "repository_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "repository01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-repository_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "repository_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "repository01",
        workspace: "workspace01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicRepositoryFlow"
}