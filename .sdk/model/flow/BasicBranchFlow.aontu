# BasicBranchFlow

main: kit: flow: BasicBranchFlow:
{
  entity: "branch",
  kind: "basic",
  name: "BasicBranchFlow",
  step: [
    {
      i: {
        ref: "branch_ref01"
      }

      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "create"
    }

    {
      i: {
        ref: "branch_ref01",
        srcdatavar: "branch_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "branch01",
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-branch_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchFlow"
}