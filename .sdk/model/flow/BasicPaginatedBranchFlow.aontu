# BasicPaginatedBranchFlow

main: kit: flow: BasicPaginatedBranchFlow:
{
  entity: "paginated_branch",
  kind: "basic",
  name: "BasicPaginatedBranchFlow",
  step: [
    {
      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "paginated_branch_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPaginatedBranchFlow"
}