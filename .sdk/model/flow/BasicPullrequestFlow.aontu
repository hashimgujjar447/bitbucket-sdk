# BasicPullrequestFlow

main: kit: flow: BasicPullrequestFlow:
{
  entity: "pullrequest",
  kind: "basic",
  name: "BasicPullrequestFlow",
  step: [
    {
      i: {
        ref: "pullrequest_ref01"
      }

      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "create"
    }

    {
      d: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      i: {
        ref: "pullrequest_ref01",
        srcdatavar: "pullrequest_ref01_data",
        suffix: "_up0",
        textfield: "created_on"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pullrequest_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pullrequest_ref01",
        srcdatavar: "pullrequest_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pullrequest01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pullrequest_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pullrequest_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "pullrequest01",
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicPullrequestFlow"
}