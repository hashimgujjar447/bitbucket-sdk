# BasicPipelineSshKeyPairFlow

main: kit: flow: BasicPipelineSshKeyPairFlow:
{
  entity: "pipeline_ssh_key_pair",
  kind: "basic",
  name: "BasicPipelineSshKeyPairFlow",
  step: [
    {
      d: {
        workspace: "workspace01"
      }

      i: {
        ref: "pipeline_ssh_key_pair_ref01",
        srcdatavar: "pipeline_ssh_key_pair_ref01_data",
        suffix: "_up0",
        textfield: "private_key"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pipeline_ssh_key_pair_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pipeline_ssh_key_pair_ref01",
        srcdatavar: "pipeline_ssh_key_pair_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pipeline_ssh_key_pair01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pipeline_ssh_key_pair_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPipelineSshKeyPairFlow"
}