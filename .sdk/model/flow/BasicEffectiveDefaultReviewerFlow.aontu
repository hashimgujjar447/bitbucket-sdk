# BasicEffectiveDefaultReviewerFlow

main: kit: flow: BasicEffectiveDefaultReviewerFlow:
{
  entity: "effective_default_reviewer",
  kind: "basic",
  name: "BasicEffectiveDefaultReviewerFlow",
  step: [
    {
      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "effective_default_reviewer_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEffectiveDefaultReviewerFlow"
}