# BasicPipelineRunnerFlow

main: kit: flow: BasicPipelineRunnerFlow:
{
  entity: "pipeline_runner",
  kind: "basic",
  name: "BasicPipelineRunnerFlow",
  step: [
    {
      i: {
        ref: "pipeline_runner_ref01"
      }

      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01",
        workspace_id: "workspace01"
      }

      o: "create"
    }

    {
      d: {
        workspace_id: "workspace01"
      }

      i: {
        ref: "pipeline_runner_ref01",
        srcdatavar: "pipeline_runner_ref01_data",
        suffix: "_up0",
        textfield: "created_on"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pipeline_runner_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pipeline_runner_ref01",
        srcdatavar: "pipeline_runner_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pipeline_runner01",
        workspace_id: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pipeline_runner_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPipelineRunnerFlow"
}