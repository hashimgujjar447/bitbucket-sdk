# BasicPaginatedEnvironmentFlow

main: kit: flow: BasicPaginatedEnvironmentFlow:
{
  entity: "paginated_environment",
  kind: "basic",
  name: "BasicPaginatedEnvironmentFlow",
  step: [
    {
      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "paginated_environment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPaginatedEnvironmentFlow"
}