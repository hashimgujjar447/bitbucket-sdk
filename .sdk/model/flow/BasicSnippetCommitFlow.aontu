# BasicSnippetCommitFlow

main: kit: flow: BasicSnippetCommitFlow:
{
  entity: "snippet_commit",
  kind: "basic",
  name: "BasicSnippetCommitFlow",
  step: [
    {
      i: {
        ref: "snippet_commit_ref01",
        srcdatavar: "snippet_commit_ref01_data",
        suffix: "_dt0"
      }

      m: {
        encoded_id: "encoded01",
        id: "snippet_commit01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-snippet_commit_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSnippetCommitFlow"
}