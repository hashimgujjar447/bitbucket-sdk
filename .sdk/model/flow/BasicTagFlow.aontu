# BasicTagFlow

main: kit: flow: BasicTagFlow:
{
  entity: "tag",
  kind: "basic",
  name: "BasicTagFlow",
  step: [
    {
      i: {
        ref: "tag_ref01"
      }

      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "create"
    }

    {
      i: {
        ref: "tag_ref01",
        srcdatavar: "tag_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "tag01",
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTagFlow"
}