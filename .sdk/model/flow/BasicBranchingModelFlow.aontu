# BasicBranchingModelFlow

main: kit: flow: BasicBranchingModelFlow:
{
  entity: "branching_model",
  kind: "basic",
  name: "BasicBranchingModelFlow",
  step: [
    {
      m: {
        repo_slug: "repo_slug01",
        workspace: "workspace01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "branching_model_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBranchingModelFlow"
}