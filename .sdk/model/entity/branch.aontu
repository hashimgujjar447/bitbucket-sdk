# Entity: branch

main: kit: entity: branch: {

  alias: field: {}

  fields: {
    default_merge_strategy: {
      h: "Default Merge Strategy"
      n: "default_merge_strategy"
      r: false
      sh: "The default merge strategy for pull requests targeting this branch."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    links: {
      h: "Links"
      n: "links"
      r: false
      t: "`$OBJECT`"
    }
    merge_strategies: {
      h: "Merge Strategies"
      n: "merge_strategies"
      r: false
      sh: "Available merge strategies for pull requests targeting this branch."
      t: "`$ARRAY`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the ref."
      t: "`$STRING`"
    }
    target: {
      h: "Target"
      n: "target"
      r: false
      t: "`$ANY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "branch"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /repositories/{workspace}/{repo_slug}/refs/branches"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "repo_slug"
                or: "repo_slug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "workspace"
                or: "workspace"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/repositories/{workspace}/{repo_slug}/refs/branches"
          q: {
            exist: [
              "repo_slug"
              "workspace"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "repositories"
            }
            {
              var: "workspace"
            }
            {
              var: "repo_slug"
            }
            {
              lit: "refs"
            }
            {
              lit: "branches"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repositories/{workspace}/{repo_slug}/refs/branches/{name}"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "name"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo_slug"
                or: "repo_slug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "workspace"
                or: "workspace"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repositories/{workspace}/{repo_slug}/refs/branches/{name}"
          q: {
            exist: [
              "id"
              "repo_slug"
              "workspace"
            ]
          }
          r: {
            param: {
              name: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "repositories"
            }
            {
              var: "workspace"
            }
            {
              var: "repo_slug"
            }
            {
              lit: "refs"
            }
            {
              lit: "branches"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.repository")]
  ]

