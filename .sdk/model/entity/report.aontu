# Entity: report

main: kit: entity: report: {

  alias: field: {}

  fields: {
    created_on: {
      fo: "date-time"
      h: "Created On"
      n: "created_on"
      r: false
      sh: "The timestamp when the report was created."
      t: "`$STRING`"
    }
    data: {
      h: "Data"
      n: "data"
      r: false
      sh: "An array of data fields to display information on the report."
      t: "`$ARRAY`"
    }
    details: {
      h: "Details"
      n: "details"
      r: false
      sh: "A string to describe the purpose of the report."
      t: "`$STRING`"
    }
    external_id: {
      h: "External Id"
      n: "external_id"
      r: false
      sh: "ID of the report provided by the report creator."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    link: {
      fo: "uri"
      h: "Link"
      n: "link"
      r: false
      sh: "A URL linking to the results of the report in an external tool."
      t: "`$STRING`"
    }
    logo_url: {
      fo: "uri"
      h: "Logo Url"
      n: "logo_url"
      r: false
      sh: "A URL to the report logo."
      t: "`$STRING`"
    }
    remote_link_enabled: {
      h: "Remote Link Enabled"
      n: "remote_link_enabled"
      r: false
      sh: "If enabled, a remote link is created in Jira for the work item associated with the commit the report belongs to."
      t: "`$BOOLEAN`"
    }
    report_type: {
      h: "Report Type"
      n: "report_type"
      r: false
      sh: "The type of the report."
      t: "`$STRING`"
    }
    reporter: {
      h: "Reporter"
      n: "reporter"
      r: false
      sh: "A string to describe the tool or company who created the report."
      t: "`$STRING`"
    }
    result: {
      h: "Result"
      n: "result"
      r: false
      sh: "The state of the report."
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: false
      sh: "The title of the report."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      t: "`$STRING`"
    }
    updated_on: {
      fo: "date-time"
      h: "Updated On"
      n: "updated_on"
      r: false
      sh: "The timestamp when the report was updated."
      t: "`$STRING`"
    }
    uuid: {
      h: "Uuid"
      n: "uuid"
      r: false
      sh: "The UUID that can be used to identify the report."
      t: "`$STRING`"
    }
  }

