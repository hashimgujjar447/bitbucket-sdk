      t: "`$ANY`"
    }
    trigger: {
      h: "Trigger"
      n: "trigger"
      r: false
      sh: "The trigger used for the pipeline."
      t: "`$ANY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      t: "`$STRING`"
    }
    uuid: {
      h: "Uuid"
      n: "uuid"
      r: false
      sh: "The UUID identifying the pipeline."
      t: "`$STRING`"
    }
    variables: {
      h: "Variables"
      n: "variables"
      r: false
      sh: "The variables for the pipeline."
      t: "`$ARRAY`"
    }
