# Entity: repository

main: kit: entity: repository: {

  alias: field: {}

  fields: {
    created_on: {
      fo: "date-time"
      h: "Created On"
      n: "created_on"
      r: false
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      t: "`$STRING`"
    }
    fork_policy: {
      h: "Fork Policy"
      n: "fork_policy"
      r: false
      sh: "Controls the rules for forking this repository."
      t: "`$STRING`"
    }
