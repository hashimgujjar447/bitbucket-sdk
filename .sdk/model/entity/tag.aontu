              "workspace"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "repositories"
            }
            {
              var: "workspace"
            }
            {
              var: "repo_slug"
            }
            {
              lit: "refs"
            }
            {
              lit: "tags"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repositories/{workspace}/{repo_slug}/refs/tags/{name}"
            source: "swagger2"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
