                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo_slug"
                or: "repo_slug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "workspace"
                or: "workspace"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repositories/{workspace}/{repo_slug}/refs/tags/{name}"
          q: {
            exist: [
              "id"
              "repo_slug"
              "workspace"
            ]
          }
          r: {
            param: {
              name: "id"
            }
