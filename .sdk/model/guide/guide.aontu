# Guide

@"@voxgig/apidef/model/guide.aontu"
@"./base-guide.aontu"

guide: entity: {
  branch_restriction: {
    active: false
  }
  branchrestriction: {
    path: {
      "/repositories/{workspace}/{repo_slug}/branch-restrictions/{id}": {
        op: {
          remove: { method: *DELETE }
        }
      }
    }
  }
}
